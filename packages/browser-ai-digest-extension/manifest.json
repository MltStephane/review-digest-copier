{
  "manifest_version": 3,
  "name": "Review Digest Copier",
  "version": "0.1.0",
  "description": "Copy GitHub PR or GitLab MR review digests into the clipboard.",
  "action": {
    "default_title": "Copy Review Digest",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*/-/merge_requests/*", "http://*/*/-/merge_requests/*"],
      "js": ["src/gitlab-mr-button.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/page-digest.js", "src/format-digest.js"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ],
  "permissions": ["activeTab", "clipboardWrite", "scripting"],
  "host_permissions": ["https://*/*", "http://*/*"]
}
